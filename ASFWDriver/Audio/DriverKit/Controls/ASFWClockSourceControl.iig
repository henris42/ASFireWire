//
// ASFWClockSourceControl.iig
// ASFWDriver
//
// The device's clock source as a HAL clock source control ('clck'), so Audio
// MIDI Setup shows and sets it. Changes go ASFWAudioDriver -> ASFWAudioNub ->
// the device protocol's ClockSource setting, and the control takes the source
// the device reports afterwards.
//

#ifndef ASFWClockSourceControl_h
#define ASFWClockSourceControl_h

#include <AudioDriverKit/IOUserAudioSelectorControl.iig>

class ASFWAudioDriver;

class ASFWClockSourceControl : public IOUserAudioSelectorControl
{
public:
    static OSSharedPtr<ASFWClockSourceControl> Create(ASFWAudioDriver* ownerDriver) LOCALONLY;

    bool init(ASFWAudioDriver* ownerDriver) LOCALONLY;

    void free() override;

    kern_return_t HandleChangeSelectedValues(const IOUserAudioSelectorValue* in_control_values,
                                             size_t in_num_values) override;

    // The name and item-name reads AudioDriverKit 21 leaks a page on,
    // answered from a cache instead (AdkPropertySerialization.hpp).
    // No 'override': IIG keeps AudioDriverKit's private class extension apart
    // from the class (IOUserAudioStream.iig redeclares these the same way).
    virtual kern_return_t _GetPropertySize(const IOUserAudioObjectPropertyAddress* in_prop_addr,
                                           OSData* in_qualifier_data,
                                           size_t* out_size) LOCALONLY;
    virtual kern_return_t _GetPropertyData(const IOUserAudioObjectPropertyAddress* in_prop_addr,
                                           OSData* in_qualifier_data,
                                           OSData** out_data) LOCALONLY;
};

struct ASFWClockSourceControl_IVars {
    ASFWAudioDriver* ownerDriver;
};

#endif /* ASFWClockSourceControl_h */
